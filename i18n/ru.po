msgid "Milka: \"That was a swipe—no tap counted. Smooth churn!\""
msgstr "Милка: «Это был свайп — нажатие не засчитано. Вот это сбивание!»"

msgid "Milka: \"A held key becomes a slide. I can hear the whisk!\""
msgstr "Милка: «Удержал клавишу — получился свайп. Прямо слышу, как взбивается молоко!»"

msgid "Milka: \"One clean tap! Not a swipe, not two clicks.\""
msgstr "Милка: «Чёткое нажатие! Не свайп и не два клика.»"

msgid "Milka: \"That was between a tap and swipe, so I did not count it.\""
msgstr "Милка: «Это было где-то между нажатием и свайпом, так что я не засчитала.»"

msgid "Milka: \"GOLDEN CREAM FEVER! Look at all that milk!!\""
msgstr "Милка: «ЗОЛОТАЯ СЛИВОЧНАЯ ЛИХОРАДКА! Сколько же тут молока!!»"

msgid "Milka: \"Nya~ You caught the meadow heartbeat!\""
msgstr "Милка: «Ня~ Ты поймал ритм луга!»"

msgid "Milka: \"Release still for a tap, or move far enough to swipe~\""
msgstr "Милка: «Не двигайся при нажатии или проведи подальше для свайпа~»"

